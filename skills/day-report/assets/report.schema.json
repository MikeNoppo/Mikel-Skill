{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "day-report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "date",
    "timezone",
    "scope",
    "title",
    "summary",
    "status",
    "status_note",
    "coverage",
    "sources",
    "changes",
    "architecture",
    "lifecycle",
    "evidence",
    "risks"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "finished",
        "in_progress",
        "blocked"
      ]
    },
    "status_note": {
      "type": "string",
      "minLength": 1
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "repository",
          "reference",
          "title",
          "url",
          "status",
          "contribution",
          "evidence"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "pr",
              "commit",
              "local",
              "investigation",
              "other"
            ]
          },
          "repository": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "contribution": {
            "type": "string",
            "enum": [
              "created",
              "worked_on",
              "related"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "before",
          "after",
          "why",
          "steps",
          "impact",
          "visual",
          "screenshot_ids",
          "source_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "finished",
              "in_progress",
              "blocked"
            ]
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "visual": {
            "type": "boolean"
          },
          "screenshot_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        }
      },
      "minItems": 0
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mermaid",
        "explanation"
      ],
      "properties": {
        "mermaid": {
          "type": "string"
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lifecycle": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "before",
          "after"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "mermaid",
                  "explanation"
                ],
                "properties": {
                  "mermaid": {
                    "type": "string"
                  },
                  "explanation": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mermaid",
              "explanation"
            ],
            "properties": {
              "mermaid": {
                "type": "string"
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "minItems": 0
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "steps"
      ],
      "properties": {
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "action",
              "observed",
              "context",
              "verification",
              "result",
              "screenshot",
              "captured_at"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "observed": {
                "type": "string",
                "minLength": 1
              },
              "context": {
                "type": "string",
                "minLength": 1
              },
              "verification": {
                "type": "string",
                "enum": [
                  "ui_only",
                  "test_flow",
                  "end_to_end",
                  "work_source"
                ]
              },
              "result": {
                "type": "string",
                "enum": [
                  "observed",
                  "pass",
                  "fail"
                ]
              },
              "screenshot": {
                "type": "string",
                "minLength": 1
              },
              "captured_at": {
                "type": "string"
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "title",
          "impact",
          "follow_up"
        ],
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "perhatian",
              "sedang",
              "rendah"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "follow_up": {
            "type": "string"
          }
        }
      },
      "minItems": 0
    }
  }
}
